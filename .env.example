# OpenRouter AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional model override (Default: google/gemini-2.0-flash-001 or meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Meta WhatsApp Cloud API (Optional - falls back to clean simulation if unset)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMTP Email Configuration (Optional - falls back to clean simulation if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
